# API and persistent database (Node.js 22.18+, recommended 24).
API_PORT=3001
DATABASE_PATH=./data/roteiro.sqlite

# Origin without trailing slash. In production use the public HTTPS origin.
PUBLIC_APP_URL=http://localhost:3000
# Railway has one trusted reverse-proxy hop. Keep unset for direct local access.
# TRUST_PROXY_HOPS=1

# Cloudflare Pages: same random secret (at least 32 characters) in both hosts.
# Configure as a secret runtime binding in Pages, never as VITE_* or browser code.
# WEB_PROXY_SECRET=

# Public instances are intended for limited use. Replace for production traffic.
OVERPASS_URL=https://overpass-api.de/api/interpreter
ROUTING_URL=https://router.project-osrm.org
GEOCODING_URL=https://photon.komoot.io

# Set production when serving the compiled frontend with the API.
# NODE_ENV=production

# O módulo de combustíveis não usa IA nem reconhecimento de texto.

# Weather forecast. Free Open-Meteo endpoint is for non-commercial low-volume use.
# Set a licensed or self-hosted endpoint before commercial distribution.
WEATHER_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_API_KEY=

# Native Android build-time backend origin. This is public configuration, not a secret.
# RDV_API_URL=https://seu-backend.example
