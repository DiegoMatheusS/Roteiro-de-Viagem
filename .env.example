# GEMINI_API_KEY: Optional, reserved for future Gemini integrations.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# API and persistent database (Node.js 22.18+, recommended 24).
API_PORT=3001
DATABASE_PATH=./data/roteiro.sqlite
OCR_CACHE_PATH=./data/ocr

# Origin without trailing slash. In production use the public HTTPS origin.
PUBLIC_APP_URL=http://localhost:3000

# Public instances are intended for limited use. Replace for production traffic.
OVERPASS_URL=https://overpass-api.de/api/interpreter
ROUTING_URL=https://router.project-osrm.org

# Set production when serving the compiled frontend with the API.
# NODE_ENV=production

# Gemini is not required by the fuel module: OCR runs locally with Tesseract.
