{
  "name": "roteiro-de-viagem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx --watch server/index.ts\" \"vite --port=3000 --host=0.0.0.0\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "start": "node --import tsx server/index.ts",
    "moderator": "node --import tsx server/moderator.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node --import tsx tests/navigation-search-ui.ts && node --import tsx tests/navigation-gps-state-ui.ts && node --import tsx tests/navigation-loading-ui.ts && node --import tsx tests/navigation-touch-ui.ts && node --import tsx tests/route-edit-ui.ts && node --import tsx tests/maplibre-standalone-ui.ts && node --import tsx tests/ui-smoke.ts && node --import tsx tests/part3-ui.ts && node --import tsx tests/part4-ui.ts && node --import tsx tests/android-sos-ui.ts",
    "admin": "node --import tsx server/moderator.ts",
    "android:sync": "node scripts/android-sync.mjs",
    "android:open": "npx cap open android",
    "android:release": "node scripts/android-release.mjs",
    "check:weather": "node --import tsx scripts/check-weather.ts",
    "admin:create": "node --import tsx server/create-admin.ts",
    "tourism:import": "node --import tsx scripts/import-tourist-catalog.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "6.4.1",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "opening_hours": "^3.15.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "tz-lookup": "^6.1.25",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tz-lookup": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "uuid": "^11.1.1"
  }
}
